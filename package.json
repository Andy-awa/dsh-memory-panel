{
  "name": "@andy-awa/dsh-memory-panel",
  "version": "0.8.0",
  "description": "Long-term memory for DeepSeek Harness: my character, your working preferences, your background facts, and a tagged corpus of your own sentences that I can recall and imitate.",
  "type": "module",
  "license": "MIT",
  "author": "Andy-awa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andy-awa/dsh-memory-panel.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "long-term-memory"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
